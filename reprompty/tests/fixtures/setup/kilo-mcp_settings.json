{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/home/example/Projects"],
      "alwaysAllow": ["read_file"],
      "disabled": false
    },
    "reprompty": {
      "command": "node",
      "args": ["/home/example/old/server.js"],
