{
  "name": "reprompty",
  "version": "0.3.0",
  "description": "AI agent orchestration framework for multi-window prompt engineering on Windows 11 and KDE/Linux (Wayland)",
  "author": "Reprompty",
  "license": "MIT",
  "repository": "github:topemalheiro/Reprompty",
  "homepage": "https://github.com/topemalheiro/Reprompty",
  "main": "dist/main/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:mcp": "esbuild src/mcp/server.ts --bundle --platform=node --format=cjs --target=node18 --main-fields=module,main --outfile=dist/mcp/server.js --external:electron",
    "build:all": "npm run build && npm run build:mcp",
    "start": "node scripts/launch.cjs",
    "mcp": "node dist/mcp/server.js",
    "test": "vitest run",
    "postinstall": "node scripts/check-electron.cjs"
  },
  "dependencies": {
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.0.0",
    "electron": "^28.3.3",
    "electron-builder": "^25.0.0",
    "esbuild": "^0.27.4",
    "jsonc-parser": "^3.3.1",
    "node-ipc": "10.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "yauzl": "^3.4.0"
  },
  "trustedDependencies": [
    "electron",
    "esbuild"
  ],
  "allowScripts": {
    "electron@28.3.3": true,
    "esbuild@0.27.4": true,
    "esbuild@0.25.12": true
  }
}
