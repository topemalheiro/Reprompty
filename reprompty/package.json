{
  "name": "reprompty",
  "version": "0.1.0",
  "description": "AI agent orchestration framework for multi-window prompt engineering on Windows 11 and KDE/Linux (Wayland)",
  "author": "Reprompty",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build",
    "build:mcp": "esbuild src/mcp/server.ts --bundle --platform=node --format=cjs --outfile=dist/mcp/server.js --external:electron",
    "start": "electron .",
    "mcp": "bun run src/mcp/server.ts"
  },
  "dependencies": {
    "node-ipc": "^10.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ws": "^8.20.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.0.0",
    "bun-types": "^1.0.0",
    "concurrently": "^8.0.0",
    "cross-env": "^10.1.0",
    "electron": "^28.3.3",
    "electron-builder": "^25.0.0",
    "esbuild": "^0.27.4",
    "png-to-ico": "^3.0.1",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "wait-on": "^7.0.0"
  }
}
